<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

<property>
  <name>mr3.runtime</name>
  <value>tez</value>
</property>

<!-- Should be pointing valid paths -->
<property>
  <name>mr3.aux.uris</name>
  <value>file:///home/gitlab-runner/mr3-run/mr3/mr3lib/mr3-tez-3.0-assembly.jar,file:///home/gitlab-runner/.m2/repository/org/apache/hadoop/hadoop-common/3.4.1/hadoop-common-3.4.1-tests.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/hive-exec-4.2.0.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/hive-llap-common-4.2.0.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/hive-llap-server-4.2.0.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/hive-llap-tez-4.2.0.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/hive-iceberg-handler-4.2.0.jar,file:///home/gitlab-runner/hive-mr3/packaging/target/apache-hive-4.2.0-bin/apache-hive-4.2.0-bin/lib/log4j-1.2-api-2.24.3.jar,file:///home/gitlab-runner/hive-mr3/ql/target/hive-exec-4.2.0-tests.jar,file:///home/gitlab-runner/hive-mr3/itests/util/target/hive-it-util-4.2.0.jar</value>
